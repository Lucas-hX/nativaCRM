# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# self-hosted infrastructure runtime and secrets
/infra/supabase-platform/
/infra/supabase/.env
/infra/supabase/.env.old
/infra/supabase/.env.example
/infra/supabase/volumes/db/data/
/infra/supabase/volumes/storage/
/infra/backups/
*.dump
*.backup

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# keep example files so forkers have a template to copy
!.env.local.example
!.env.example
# The full self-hosted Supabase template contains upstream default
# credentials. Keep the local copy, but never publish it from this repo.
/infra/supabase/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
